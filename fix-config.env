# Fix for M1 (L0 chatbot) direct prompt-injection token disclosure.
# Applied via the lab's "Hardened" toggle for the M1 session; the equivalent
# persistent configuration is the two flags below (or HALCYON_MODE=secure to
# enable all SEC_* defences at once).

SEC_SYSTEM_PROMPT_HARDENING=on   # removes the honeytoken from the prompt; separates system role from user input
SEC_INPUT_FILTER=on              # blocks injection keywords BEFORE the model is called
